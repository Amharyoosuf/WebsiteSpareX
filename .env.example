# Copy to .env and fill in.

# SQLite (default). For Postgres on Railway, set this to the Railway Postgres URL
# and change datasource provider to "postgresql" in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Public site URL for SEO (sitemap/robots). e.g. https://sparex.lk — no trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin login password.
ADMIN_PASSWORD="change-me"

# Long random string used to sign the admin session cookie.
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Cloudflare R2 image storage (optional) ---
# Leave blank to store uploads locally under /public/uploads.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
